# openoms configuration — every value here is optional.
#
# openoms reads oms.toml first — run `oms init` to generate it. This file is only
# needed to override those settings, which is mainly how containers inject them.
#
# Database settings default to a local Postgres (localhost:5432, superuser
# `postgres`, database `ods`), or to whatever `oms init` wrote to `oms.toml`. They
# can also be given as flags to `cargo run -- database ...`. Set them here only to
# override the file — e.g. to point a container at a different Postgres. Note
# there is no file tier for the superuser password: it is never stored, so this is
# the only way to supply it non-interactively.
#
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DATABASE=ods

# Password for the `oms` role that `database init` creates and the server connects
# as. `oms init` generates one into `oms.toml` for you — set this only to override
# it. Change it for anything that is not a local development machine — the server
# refuses to start with the built-in default against a non-loopback host.
# OMS_PASSWORD=openoms-dev

# Server. Both have built-in defaults that apply only while the bind address is
# loopback — bind anywhere else without setting OMS_ADMIN_PASSWORD and the server
# refuses to start. `oms init` generates a cockpit password into `oms.toml` for
# you; set OMS_ADMIN_PASSWORD here only to override it.
#
# Keep these commented out. Env beats oms.toml, and copying this file verbatim
# (as the README tells you to do for a non-local database) would otherwise
# replace your generated cockpit password with a value published in this repo —
# and the off-loopback guard cannot catch that, since it only refuses the
# *built-in* default, not whatever placeholder ends up here.
# OMS_BIND_ADDR=localhost:3001
# OMS_ADMIN_AUTH_ENABLED=true
# OMS_ADMIN_PASSWORD=change-me-to-a-secure-random-token

# Brokers — a broker_connection row is created for each of these on every boot,
# regardless of credentials. *_ENV selects which one routes (PAPER or LIVE).
ALPACA_ENV=PAPER
BINANCE_ENV=PAPER

# Broker and feed credentials are no longer read from the environment — they live
# encrypted in Postgres, sealed with oms.master_key. Run `oms config import-env`
# once to migrate ALPACA_*/BINANCE_*/DATABENTO_API_KEY out of an existing `.env`
# and into the store; after that this file has nothing credential-shaped left to
# set. A cockpit screen for entering them directly is coming in a later plan.

# Instrument catalog. With broker credentials imported into the store, an empty
# catalog is populated in the background on boot — this is what fills a freshly
# `init`ed database.
# OMS_SYNC_ON_BOOT=never          # opt out; anything else (incl. unset) is if-empty
# OMS_SYNC_UNDERLYINGS=SPY,QQQ    # limit the option chains fetched (default: all)
# OPENFIGI_API_KEY=               # raises OpenFIGI rate limits during the sync

# Market data
# BINANCE_FEED_WS_URL=            # override the Binance feed websocket endpoint

# Kafka (optional)
KAFKA_BROKER=
KAFKA_TOPIC=
KAFKA_CLIENT_ID=
KAFKA_PROJECTOR_GROUP_ID=
