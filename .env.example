# openoms configuration — every value here is optional.
#
# Database settings default to a local Postgres (localhost:5432, superuser
# `postgres`, database `ods`) and can also be given as flags to
# `cargo run -- database ...`. Set them here only to point somewhere else.
#
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DATABASE=ods

# Password for the `oms` role that `database init` creates and the server connects
# as. Change it for anything that is not a local development machine — the server
# refuses to start with the built-in default against a non-loopback host.
# OMS_PASSWORD=openoms-dev

# Server. Both have built-in defaults that apply only while the bind address is
# loopback — bind anywhere else without setting OMS_ADMIN_PASSWORD and the server
# refuses to start.
OMS_BIND_ADDR=localhost:3001
OMS_ADMIN_AUTH_ENABLED=true
OMS_ADMIN_PASSWORD=change-me-to-a-secure-random-token

# Brokers — a broker with credentials gets a broker_connection row on boot.
# *_ENV selects which credential pair below is used (PAPER or LIVE).
ALPACA_ENV=PAPER
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
BINANCE_ENV=PAPER
BINANCE_PAPER_API_KEY=
BINANCE_PAPER_PRIVATE_KEY_PATH=

# Instrument catalog. With broker credentials set, an empty catalog is populated
# in the background on boot — this is what fills a freshly `init`ed database.
# OMS_SYNC_ON_BOOT=never          # opt out; anything else (incl. unset) is if-empty
# OMS_SYNC_UNDERLYINGS=SPY,QQQ    # limit the option chains fetched (default: all)
# OPENFIGI_API_KEY=               # raises OpenFIGI rate limits during the sync

# Market data
DATABENTO_API_KEY=
# BINANCE_FEED_WS_URL=            # override the Binance feed websocket endpoint

# Kafka (optional)
KAFKA_BROKER=
KAFKA_TOPIC=
KAFKA_CLIENT_ID=
KAFKA_PROJECTOR_GROUP_ID=
