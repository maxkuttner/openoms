---
// Shipped architecture by default; target=true shows the proposed embedded runtime.
// Hand-placed SVG rather than Mermaid: at this size an automatic layout tangles
// the edges. It reads top to bottom so it fits the content column; edges run in
// the gaps between columns and are drawn before the boxes. Box and text colours follow Starlight's theme variables, so the
// figure follows light and dark mode; the accents mean the same in both
// (see the legend). On a narrow screen the figure keeps its size and scrolls.
interface Props { target?: boolean }
const { target = false } = Astro.props;
---

<figure class="arch">
  <div class="arch-scroll">
    {target ? (
    <svg viewBox="0 0 800 780" role="img" aria-labelledby="target-title target-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="target-title">Proposed target: embedded co-located execution runtime</title>
      <desc id="target-desc">Not implemented. Central OMS distributes bootstrap configuration, versioned policy and control asynchronously. Inside one co-located process, strategy calls runtime directly. Runtime uses shared risk rules, owns local positions, reservations, order lifecycle and recovery journal, and calls the venue adapter. Venue reports update runtime immediately; replayable events flow to OMS accounting. OMS independently reconciles with the venue. The OMS order path also uses the shared risk library. No per-order OMS or database round trip.</desc>
      <defs>
        {["order", "event", "price", "control"].map((k) => (
          <marker id={`target-arrow-${k}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class={`arch-head-${k}`} />
          </marker>
        ))}
      </defs>
      <text class="arch-caps arch-colo-label" x="30" y="28">PROPOSED TARGET · NOT IMPLEMENTED</text>
      <rect class="arch-region" x="30" y="44" width="740" height="156" rx="14" />
      <text class="arch-region-label" x="50" y="68">CENTRAL OMS · policy, supervision and durable accounting</text>
      <g class="arch-box arch-strategy"><rect x="50" y="86" width="210" height="88" rx="8" /><text class="arch-name" x="155" y="111" text-anchor="middle">Configuration + control</text><text class="arch-sub" x="155" y="133" text-anchor="middle">snapshot · policy · budgets</text><text class="arch-sub" x="155" y="153" text-anchor="middle">authority · kill · acknowledgements</text></g>
      <g class="arch-box"><rect x="290" y="86" width="210" height="88" rx="8" /><text class="arch-name" x="395" y="111" text-anchor="middle">Path ① admission</text><text class="arch-sub" x="395" y="133" text-anchor="middle">shared risk rules + DB transaction</text><text class="arch-sub" x="395" y="153" text-anchor="middle">existing OMS execution path</text></g>
      <g class="arch-box arch-key"><rect x="530" y="86" width="220" height="88" rx="8" /><text class="arch-name" x="640" y="111" text-anchor="middle">Accounting + recon</text><text class="arch-sub" x="640" y="133" text-anchor="middle">deduplicate · book · persist</text><text class="arch-sub" x="640" y="153" text-anchor="middle">independent venue observation</text></g>

      <path class="arch-edge arch-edge-control target-control" d="M155,174 L155,210 L20,210 L20,318 L270,318" />
      <text class="arch-edge-label arch-label-control" x="165" y="228">bootstrap / policy / commands ↓</text>
      <text class="arch-edge-label" x="165" y="248">async link · policy ACKs ↑ / event ACKs ↓</text>
      <path class="arch-edge arch-edge-event target-event target-event-acks" d="M620,312 L620,174" />
      <text class="arch-edge-label arch-label-event" x="610" y="272" text-anchor="end">↑ lifecycle / fills / health · replay + durable ACK</text>

      <rect class="arch-region arch-region-colo" x="30" y="280" width="690" height="338" rx="14" />
      <text class="arch-region-label arch-colo-label" x="50" y="302">② ONE CO-LOCATED PROCESS · trusted strategy, dedicated account</text>
      <g class="arch-box arch-strategy"><rect x="50" y="326" width="145" height="96" rx="8" /><text class="arch-name" x="122" y="355" text-anchor="middle">Strategy logic</text><text class="arch-sub" x="122" y="379" text-anchor="middle">decides what to trade</text><text class="arch-sub" x="122" y="402" text-anchor="middle">submit / cancel API</text></g>
      <path class="arch-edge arch-edge-order target-order" d="M195,370 L270,370" />
      <text class="arch-edge-label arch-label-order" x="232" y="347" text-anchor="middle">call</text>

      <g class="arch-box arch-key"><rect x="270" y="312" width="430" height="202" rx="10" /><text class="arch-name" x="485" y="339" text-anchor="middle">Embedded execution runtime</text><text class="arch-sub" x="485" y="362" text-anchor="middle">atomic check + reserve · order lifecycle · local positions</text><text class="arch-sub" x="485" y="384" text-anchor="middle">cached configuration · authority / feed health · recovery</text></g>
      <g class="arch-box arch-crate"><rect x="290" y="404" width="180" height="88" rx="8" /><text class="arch-name" x="380" y="430" text-anchor="middle">Shared risk crate</text><text class="arch-sub" x="380" y="452" text-anchor="middle">rules · units · Reducing</text><text class="arch-sub" x="380" y="474" text-anchor="middle">same evaluator as path ①</text></g>
      <g class="arch-box"><rect x="490" y="404" width="190" height="88" rx="8" /><text class="arch-name" x="585" y="430" text-anchor="middle">Local journal</text><text class="arch-sub" x="585" y="452" text-anchor="middle">durable intent before send</text><text class="arch-sub" x="585" y="474" text-anchor="middle">recovery + event replay</text></g>
      <path class="arch-edge arch-edge-order target-order" d="M420,514 L420,548" />
      <path class="arch-edge arch-edge-event target-event" d="M620,548 L620,514" />
      <text class="arch-edge-label arch-label-event" x="630" y="537">reports ↑</text>
      <g class="arch-box"><rect x="270" y="548" width="430" height="48" rx="8" /><text class="arch-name" x="485" y="570" text-anchor="middle">Gateway crate · venue adapter + market data</text><text class="arch-sub" x="485" y="587" text-anchor="middle">linked library · no extra process or internal REST hop</text></g>
      <path class="arch-edge arch-edge-price target-price" d="M270,572 L122,572 L122,422" />
      <text class="arch-edge-label arch-label-price" x="132" y="548">market data ↑</text>

      <path class="arch-edge arch-edge-order target-order" d="M420,596 L420,664" />
      <text class="arch-edge-label arch-label-order" x="410" y="644" text-anchor="end">orders ↓</text>
      <path class="arch-edge arch-edge-event target-event" d="M590,664 L590,596" />
      <text class="arch-edge-label arch-label-event" x="600" y="644">reports / prices ↑</text>
      <path class="arch-edge arch-edge-event target-event" d="M700,696 L760,696 L760,184 L710,184 L710,174" />
      <text class="arch-edge-label arch-label-event" transform="translate(752 470) rotate(-90)" text-anchor="middle">independent OMS venue follow / reconciliation</text>
      <g class="arch-box arch-venue"><rect x="270" y="664" width="430" height="62" rx="8" /><text class="arch-name" x="485" y="690" text-anchor="middle">Venue · dedicated account / subaccount</text><text class="arch-sub" x="485" y="711" text-anchor="middle">one active runtime · bounded allocation · reconcile before trading</text></g>
      <text class="arch-sub arch-colo-note" x="400" y="758" text-anchor="middle">No per-order OMS / database round trip. Local journal latency remains part of admission.</text>
    </svg>
    ) : (
    <svg
      viewBox="0 0 800 1100"
      role="img"
      aria-labelledby="arch-title arch-desc"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title id="arch-title">OpenOMS architecture</title>
      <desc id="arch-desc">
        From top to bottom: users, strategies and the Authentik sign-in service; the OMS core with the order
        engine, event store, event bus and the users and access tables (invites, roles, identities) that sign-in checks against; the order and market data gateways;
        the brokers, crypto venues and data vendors they connect to. At the
        bottom, a co-located strategy trades a crypto venue directly while the
        OMS follows its account and controls it over the control link.
      </desc>
      <defs>
        {["order", "event", "price", "control", "auth"].map((k) => (
          <marker id={`arch-arrow-${k}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class={`arch-head-${k}`} />
          </marker>
        ))}
      </defs>

      <!-- Regions: drawn first, so everything sits on top -->
      <rect class="arch-region" x="14" y="116" width="772" height="680" rx="14" />
      <text class="arch-region-label" x="752" y="140" text-anchor="end">ONE OMS PROGRAM · one binary, one process</text>
      <text class="arch-caps" x="525" y="168" text-anchor="middle">OMS CORE · durable accounting state</text>
      <line class="arch-boundary" x1="30" y1="598" x2="770" y2="598" />
      <text class="arch-caps" x="470" y="616" text-anchor="middle">GATEWAYS · no database, no Kafka</text>
      <text class="arch-caps" x="60" y="24">USERS</text>
      <text class="arch-caps" x="60" y="818">OUTSIDE</text>
      <rect class="arch-region arch-region-colo" x="14" y="908" width="772" height="180" rx="14" />
      <text class="arch-region-label arch-colo-label" x="30" y="932">② CO-LOCATED SERVER · a separate program, next to the venue</text>

      <!-- Edges: drawn before the boxes, which cover their ends -->
      <path class="arch-edge arch-edge-order" d="M125,96 C125,140 120,140 120,180" />
      <path class="arch-edge arch-edge-order" d="M267,96 C267,140 160,136 160,180" />
      <path class="arch-edge arch-edge-order" d="M409,96 C409,150 200,132 200,180" />
      <path class="arch-edge arch-edge-order" d="M240,224 L262,224 L262,626" />
      <text class="arch-edge-label arch-label-order" transform="translate(256 520) rotate(-90)" text-anchor="middle">NewOrder · Cancel</text>
      <path class="arch-edge arch-edge-event" d="M288,626 L288,210 L310,210" />
      <text class="arch-edge-label arch-label-event" transform="translate(298 470) rotate(-90)" text-anchor="middle">ExecEvent</text>
      <path class="arch-edge arch-edge-event" d="M490,210 L560,210" />
      <path class="arch-edge arch-edge-event" d="M650,240 L650,262" />
      <path class="arch-edge arch-edge-event" d="M740,292 L782,292 L782,20 L551,20 L551,34" />
      <text class="arch-edge-label arch-label-event" transform="translate(776 180) rotate(-90)" text-anchor="middle">Kafka</text>
      <path class="arch-edge arch-edge-auth" d="M693,96 L693,106 L760,106 L760,538 L740,538" />
      <text class="arch-edge-label arch-label-auth" transform="translate(754 330) rotate(-90)" text-anchor="middle">OIDC sign-in · invite claim</text>
      <path class="arch-edge arch-edge-event" d="M400,240 L400,344" />
      <path class="arch-edge arch-edge-event" d="M400,404 L400,426" />
      <path class="arch-edge arch-edge-event" d="M200,626 L200,568" />
      <text class="arch-edge-label arch-label-event" x="206" y="590">followed fills</text>
      <path class="arch-edge arch-edge-price" d="M650,626 L650,486" />
      <text class="arch-edge-label arch-label-price" x="656" y="560">Quote</text>
      <path class="arch-edge arch-edge-price" d="M650,426 L650,404" />
      <path class="arch-edge arch-edge-control" d="M150,486 L150,508" />
      <path class="arch-edge arch-edge-order" d="M140,776 L140,828" />
      <path class="arch-edge arch-edge-order" d="M300,776 L300,828" />
      <path class="arch-edge arch-edge-event" d="M340,828 L340,776" />
      <path class="arch-edge arch-edge-price" d="M480,828 L480,776" />
      <path class="arch-edge arch-edge-price" d="M660,828 L660,776" />
      <path class="arch-edge arch-edge-order" d="M640,948 L640,906 L520,906 L520,890" />
      <text class="arch-edge-label arch-label-order" x="648" y="934">direct orders</text>
      <path class="arch-edge arch-edge-control" d="M60,540 L30,540 L30,985 L60,985" />
      <text class="arch-edge-label arch-label-control" transform="translate(24 770) rotate(-90)" text-anchor="middle">control link · kill · limits · positions</text>

      <!-- Users -->
      <g class="arch-box arch-user"><rect x="60" y="34" width="130" height="62" rx="8" /><text x="125" y="60" text-anchor="middle" class="arch-name">Cockpit</text><text x="125" y="78" text-anchor="middle" class="arch-sub">admin, users, blotter</text></g>
      <g class="arch-box arch-user"><rect x="202" y="34" width="130" height="62" rx="8" /><text x="267" y="60" text-anchor="middle" class="arch-name">Trader UI</text><text x="267" y="78" text-anchor="middle" class="arch-sub">invited users</text></g>
      <g class="arch-box arch-strategy"><rect x="344" y="34" width="130" height="62" rx="8" /><text x="409" y="60" text-anchor="middle" class="arch-name">Strategies ①</text><text x="409" y="78" text-anchor="middle" class="arch-sub">FIX or REST</text></g>
      <g class="arch-box arch-ext"><rect x="486" y="34" width="130" height="62" rx="8" /><text x="551" y="60" text-anchor="middle" class="arch-name">Other systems</text><text x="551" y="78" text-anchor="middle" class="arch-sub">risk, accounting…</text></g>
      <g class="arch-box arch-ext"><rect x="628" y="34" width="130" height="62" rx="8" /><text x="693" y="60" text-anchor="middle" class="arch-name">Authentik</text><text x="693" y="78" text-anchor="middle" class="arch-sub">sign-in · SSO</text></g>

      <!-- Core: three columns, four rows; the bus spans the right two -->
      <g class="arch-box"><rect x="60" y="180" width="180" height="60" rx="8" /><text x="150" y="205" text-anchor="middle" class="arch-name">Order API + Risk</text><text x="150" y="223" text-anchor="middle" class="arch-sub">role checks, risk, store</text></g>
      <g class="arch-box arch-key"><rect x="310" y="180" width="180" height="60" rx="8" /><text x="400" y="205" text-anchor="middle" class="arch-name">Order engine</text><text x="400" y="223" text-anchor="middle" class="arch-sub">the only place fills book</text></g>
      <g class="arch-box"><rect x="560" y="180" width="180" height="60" rx="8" /><text x="650" y="205" text-anchor="middle" class="arch-name">Event store</text><text x="650" y="223" text-anchor="middle" class="arch-sub">append-only, Postgres</text></g>

      <g class="arch-box"><rect x="60" y="262" width="180" height="60" rx="8" /><text x="150" y="287" text-anchor="middle" class="arch-name">Order recon</text><text x="150" y="305" text-anchor="middle" class="arch-sub">asks the gateway on reconnect</text></g>
      <g class="arch-box"><rect x="560" y="262" width="180" height="60" rx="8" /><text x="650" y="287" text-anchor="middle" class="arch-name">Kafka outbox</text><text x="650" y="305" text-anchor="middle" class="arch-sub">optional · from the store</text></g>

      <rect class="arch-bus" x="310" y="334" width="430" height="80" rx="10" />
      <text class="arch-caps" x="525" y="356" text-anchor="middle">EVENT BUS · in memory</text>
      <rect class="arch-lane arch-lane-event" x="326" y="370" width="200" height="30" rx="6" />
      <text class="arch-lane-text" x="426" y="390" text-anchor="middle">order lane · after commit</text>
      <rect class="arch-lane arch-lane-price" x="534" y="370" width="190" height="30" rx="6" />
      <text class="arch-lane-text" x="629" y="390" text-anchor="middle">price lane · latest wins</text>

      <g class="arch-box arch-strategy"><rect x="60" y="426" width="180" height="60" rx="8" /><text x="150" y="451" text-anchor="middle" class="arch-name">Strategy registry</text><text x="150" y="469" text-anchor="middle" class="arch-sub">responsible user · Kill</text></g>
      <g class="arch-box"><rect x="310" y="426" width="180" height="60" rx="8" /><text x="400" y="451" text-anchor="middle" class="arch-name">Positions &amp; P&amp;L</text><text x="400" y="469" text-anchor="middle" class="arch-sub">from fills and marks</text></g>
      <g class="arch-box"><rect x="560" y="426" width="180" height="60" rx="8" /><text x="650" y="451" text-anchor="middle" class="arch-name">Pricing</text><text x="650" y="469" text-anchor="middle" class="arch-sub">best live source → mark</text></g>

      <g class="arch-box arch-strategy"><rect x="60" y="508" width="180" height="60" rx="8" /><text x="150" y="533" text-anchor="middle" class="arch-name">Co-located hub</text><text x="150" y="551" text-anchor="middle" class="arch-sub">books fills · link · alarms</text></g>
      <g class="arch-box"><rect x="310" y="508" width="180" height="60" rx="8" /><text x="400" y="533" text-anchor="middle" class="arch-name">UI updates</text><text x="400" y="551" text-anchor="middle" class="arch-sub">bus → open screens, live</text></g>

      <g class="arch-box"><rect x="560" y="508" width="180" height="60" rx="8" /><text x="650" y="533" text-anchor="middle" class="arch-name">Users &amp; access</text><text x="650" y="551" text-anchor="middle" class="arch-sub">roles · invites · identities</text></g>

      <!-- Gateways -->
      <g class="arch-gw"><rect x="60" y="626" width="330" height="150" rx="10" /><text x="225" y="650" text-anchor="middle" class="arch-name">Order gateway</text><text x="225" y="667" text-anchor="middle" class="arch-sub">orders and fills only · sessions, reconnect, health</text></g>
      {[
        ["Alpaca", 76], ["IBKR · FIX", 180], ["Binance", 284],
      ].map(([label, x]) => (
        <g class="arch-chip"><rect x={x} y="678" width="96" height="26" rx="13" /><text x={(x as number) + 48} y="695" text-anchor="middle">{label}</text></g>
      ))}
      {[
        ["Bybit", 76], ["OKX", 180], ["Coinbase", 284],
      ].map(([label, x]) => (
        <g class="arch-chip"><rect x={x} y="710" width="96" height="26" rx="13" /><text x={(x as number) + 48} y="727" text-anchor="middle">{label}</text></g>
      ))}
      <g class="arch-chip arch-chip-strategy"><rect x="76" y="742" width="304" height="26" rx="13" /><text x="228" y="759" text-anchor="middle">follow streams · co-located accounts</text></g>

      <g class="arch-gw"><rect x="410" y="626" width="330" height="150" rx="10" /><text x="575" y="650" text-anchor="middle" class="arch-name">Market data gateway</text><text x="575" y="667" text-anchor="middle" class="arch-sub">prices only · instruments the OMS holds</text></g>
      {[
        ["Binance", 426], ["Bybit", 530], ["OKX", 634],
      ].map(([label, x]) => (
        <g class="arch-chip arch-chip-price"><rect x={x} y="678" width="96" height="26" rx="13" /><text x={(x as number) + 48} y="695" text-anchor="middle">{label}</text></g>
      ))}
      <g class="arch-chip arch-chip-price"><rect x="426" y="710" width="96" height="26" rx="13" /><text x="474" y="727" text-anchor="middle">Coinbase</text></g>
      <g class="arch-chip arch-chip-price"><rect x="530" y="710" width="200" height="26" rx="13" /><text x="630" y="727" text-anchor="middle">OPRA · US options</text></g>

      <!-- Outside -->
      <g class="arch-box arch-venue"><rect x="60" y="828" width="160" height="62" rx="8" /><text x="140" y="854" text-anchor="middle" class="arch-name">Brokers</text><text x="140" y="872" text-anchor="middle" class="arch-sub">IBKR · Alpaca</text></g>
      <g class="arch-box arch-venue"><rect x="240" y="828" width="320" height="62" rx="8" /><text x="400" y="854" text-anchor="middle" class="arch-name">Crypto venues</text><text x="400" y="872" text-anchor="middle" class="arch-sub">Binance · Bybit · OKX · Coinbase · orders and prices</text></g>
      <g class="arch-box arch-venue"><rect x="580" y="828" width="160" height="62" rx="8" /><text x="660" y="854" text-anchor="middle" class="arch-name">Data vendors</text><text x="660" y="872" text-anchor="middle" class="arch-sub">OPRA · prices</text></g>

      <!-- Co-located server -->
      <g class="arch-box arch-strategy"><rect x="60" y="948" width="180" height="74" rx="8" /><text x="150" y="974" text-anchor="middle" class="arch-name">Strategy program</text><text x="150" y="992" text-anchor="middle" class="arch-sub">market maker, arbitrage…</text><text x="150" y="1008" text-anchor="middle" class="arch-sub">never waits on the OMS</text></g>
      {[
        ["risk", "shared pre-trade rules", 260],
        ["colo-runtime", "journal · reservations", 440],
        ["colo-link + gateway", "v2 control · venue", 620],
      ].map(([name, sub, x]) => (
        <g class="arch-box arch-crate"><rect x={x} y="948" width="160" height="74" rx="8" /><text x={(x as number) + 80} y="979" text-anchor="middle" class="arch-name">{name}</text><text x={(x as number) + 80} y="998" text-anchor="middle" class="arch-sub">{sub}</text></g>
      ))}
      <text class="arch-sub arch-colo-note" x="420" y="1052" text-anchor="middle">Crates from this repository, linked into the program. It trades its own venue account;</text>
      <text class="arch-sub arch-colo-note" x="420" y="1070" text-anchor="middle">the OMS follows and books fills, and independently attempts account-wide cancellation.</text>
    </svg>
    )}
  </div>
  <ul class="arch-legend" aria-label="Legend">
    <li><span class="arch-swatch arch-swatch-order"></span>an order going out</li>
    <li><span class="arch-swatch arch-swatch-event"></span>order and fill events</li>
    <li><span class="arch-swatch arch-swatch-price"></span>prices</li>
    <li><span class="arch-swatch arch-swatch-strategy"></span>strategies</li>
    <li><span class="arch-swatch arch-swatch-control"></span>kill and limits</li>
    <li><span class="arch-swatch arch-swatch-auth"></span>sign-in</li>
  </ul>
</figure>

<style>
  .arch {
    --arch-order: #3b82f6;
    --arch-event: #25b083;
    --arch-price: #e0962c;
    --arch-strategy: #c45ad6;
    --arch-control: #e5484d;
    --arch-text: var(--sl-color-white);
    --arch-muted: var(--sl-color-gray-3);
    --arch-box: var(--sl-color-gray-6);
    --arch-box-alt: var(--sl-color-gray-5);
    --arch-line: var(--sl-color-gray-4);
    margin-block: 1.5rem;
  }
  /* Starlight's grays darken fast in light mode: one step lighter there. */
  :global(:root[data-theme="light"]) .arch {
    --arch-box: var(--sl-color-gray-7, #f5f6f8);
    --arch-box-alt: var(--sl-color-gray-6);
  }
  .arch-scroll {
    overflow-x: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .arch svg {
    display: block;
    width: 100%;
    min-width: 560px;
    max-width: 820px;
    margin-inline: auto;
    height: auto;
    font-family: var(--sl-font, system-ui, sans-serif);
  }
  .arch-region {
    fill: none;
    stroke: var(--arch-line);
    stroke-width: 1.2;
    stroke-dasharray: 6 5;
  }
  .arch-region-colo {
    stroke: var(--arch-strategy);
  }
  .arch-region-label,
  .arch-caps {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: var(--arch-muted);
  }
  .arch-colo-label {
    fill: var(--arch-strategy);
